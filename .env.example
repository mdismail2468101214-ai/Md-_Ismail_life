# Environment Variables Configuration
# Copy this file to .env or configure these variables in your hosting provider's dashboard (e.g., Vercel, Netlify, Render).
# Note: The application comes with a working default Firebase configuration in firebase-applet-config.json.
# These environment variables are OPTIONAL and allow you to override Firebase settings or custom deploy configurations.

# Optional Firebase Configuration overrides
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Optional Base Path (defaults to './' for universal static hosting)
VITE_BASE_PATH=""
