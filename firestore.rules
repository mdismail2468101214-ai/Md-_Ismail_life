rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio Collections
    match /profile/{docId} {
      allow read, write: if true;
    }

    match /life_story/{docId} {
      allow read, write: if true;
    }

    match /education/{docId} {
      allow read, write: if true;
    }

    match /projects/{docId} {
      allow read, write: if true;
    }

    match /creations/{docId} {
      allow read, write: if true;
    }

    match /gallery/{docId} {
      allow read, write: if true;
    }

    match /videos/{docId} {
      allow read, write: if true;
    }

    match /favorites/{docId} {
      allow read, write: if true;
    }

    match /blog_posts/{docId} {
      allow read, write: if true;
    }

    match /achievements/{docId} {
      allow read, write: if true;
    }

    match /future_goals/{docId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /contact_messages/{docId} {
      allow read, write: if true;
    }
  }
}
