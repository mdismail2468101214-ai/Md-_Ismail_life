rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public readable collections
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /life_story/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /education/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /projects/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /creations/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /videos/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /favorites/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /blog_posts/{docId} {
      allow read: if resource.data.published == true || isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /achievements/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /future_goals/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /contact_messages/{docId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.email is string
                    && request.resource.data.message is string;
      allow read, update, delete: if isAuthenticated();
    }
  }
}
